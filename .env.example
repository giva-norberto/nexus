# Nexus — exemplo de configuração segura
NEXUS_FREE_ONLY=true
COST_UNKNOWN_ACTION=deny

# Governança
REQUIRE_APPROVAL_DATA_WRITE=true
REQUIRE_APPROVAL_DATA_DELETE=true
REQUIRE_APPROVAL_RULE_CHANGE=true
REQUIRE_APPROVAL_PERMISSION_CHANGE=true
REQUIRE_APPROVAL_BILLING_CHANGE=true
REQUIRE_APPROVAL_MERGE=true
REQUIRE_APPROVAL_DEPLOY=true
ALLOW_FORCE_PUSH=false
ALLOW_DIRECT_MAIN_WRITE=false

# Automação — desligada por padrão
MONITOR_INTERVAL_MINUTES=0
DAILY_REPORT_HOUR=0
TIMEZONE=America/Sao_Paulo

# Provedores gratuitos — preencher somente no ambiente real
GOOGLE_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=

# Provedores pagos — permanecem bloqueados com NEXUS_FREE_ONLY=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub
GITHUB_USER=giva-norberto
GITHUB_TOKEN=

# Firebase — configuração futura
FIREBASE_CREDENTIALS_DIR=./secrets
FIRESTORE_READ_BUDGET=20000
COUNT_CACHE_MINUTES=60
